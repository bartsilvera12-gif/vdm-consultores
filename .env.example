# Supabase — URL y anon key del proyecto.
# Las necesita el bundle del frontend (prefijo VITE_ para que Vite las exponga).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# Opcional: override del slug de la Edge Function (por defecto "enviar-consulta").
# VITE_SUPABASE_CONSULTAS_FUNCTION=enviar-consulta

# --- Deploy FTP a Hostinger (solo local, NO se commitea) ---
# Copiá estas líneas a .env.local y completá con los datos de hPanel > FTP.
# El deploy (npm run deploy) sube el contenido de dist/ al servidor.
FTP_HOST=ftp.vdmconsultores.com.py
FTP_USER=tu-usuario-ftp
FTP_PASS=tu-contraseña-ftp
# Carpeta remota raíz del sitio (en Hostinger suele ser /public_html).
FTP_REMOTE_DIR=/public_html
