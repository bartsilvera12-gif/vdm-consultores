# VDM Consultores — Apache config para SPA + MIME + compresión + caché.
# Al ser una Single Page Application (React Router), cualquier ruta
# desconocida (/admin, /servicios, /contacto, ...) debe servir index.html
# para que el router del cliente la resuelva.

# --- SPA fallback -----------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # www → dominio sin www (una sola versión del sitio para Google).
  RewriteCond %{HTTP_HOST} ^www\.vdmconsultores\.com\.py$ [NC]
  RewriteRule ^(.*)$ https://vdmconsultores.com.py/$1 [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# LiteSpeed (algunos planes de Hostinger lo usan en vez de Apache estándar):
# también respeta mod_rewrite, pero por si acaso dejamos la directiva alterna.
<IfModule LiteSpeed>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# --- MIME types correctos ---------------------------------------------------
# Vital: módulos ES deben llegar como application/javascript, no text/plain.
<IfModule mod_mime.c>
  AddType application/javascript  .js .mjs
  AddType text/css                .css
  AddType image/svg+xml           .svg
  AddType image/webp              .webp
  AddType application/json        .json
  AddType application/manifest+json .webmanifest
  AddType font/woff2              .woff2
</IfModule>

# --- Compresión gzip --------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# --- Caché agresiva para assets fingerprinted -------------------------------
# El index.html NO se cachea (siempre refleja el deploy más reciente).
# Los assets de /assets/ llevan hash en el nombre: cache busting automático.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|webp|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Seguridad básica -------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS: habilitar sólo cuando HTTPS esté 100% configurado.
  # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
